# Copy to `.env` (git-ignored) and fill in. NEVER commit real keys.

# EVM — hex private key (with or without 0x)
EVM_RPC=https://polygon-rpc.com
EVM_PRIVATE_KEY=

# Solana — base58 secret, JSON byte array, or path to a keypair .json
SOL_RPC=https://api.mainnet-beta.solana.com
SOL_PRIVATE_KEY=

# Hard cap on recipients per bulk run
MAX_BULK_RECIPIENTS=500
